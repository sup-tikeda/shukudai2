# このファイルをコピーして .env を作成してください（.env はコミットしないこと）
# cp .env.example .env

# --- PostgreSQL (docker-compose.yml がこの値でコンテナを作る) ---
POSTGRES_USER=app
# URLに使うため英数字のみにする（@ : / などを含めると DATABASE_URL が壊れる）
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
# ホスト側の公開ポート。5432に既存のPostgreSQLがある環境向けに5433を既定とする
POSTGRES_PORT=5433
# ホストから接続するときの接続先（pnpm dev / pnpm db:migrate / pnpm db:seed 用）。
# アプリをコンテナで動かす場合は docker-compose.yml が postgres:5432 に上書きする。
DATABASE_URL=postgres://app:change-me@localhost:5433/app

# --- nginx（アプリへのリバースプロキシ。docker-composeでアプリまで動かす場合の公開ポート） ---
# アプリコンテナ自体はホストへ直接公開せず、nginx経由でのみアクセスする
NGINX_PORT=8080
# 外部公開する際の入り口保護（Basic認証）。ID/パスワードは推測されにくい値に変更すること
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me

# --- Cloudflare Tunnel（cloudflaredサービスがQuick Tunnelで一時的に外部公開する） ---
# `docker compose logs cloudflared` に表示される https://xxxx.trycloudflare.com を設定し、
# `docker compose up -d app` で反映する（再起動のたびにURLが変わるため、その都度更新が必要）。
# 未設定の場合は今までどおり http://localhost:NGINX_PORT のまま。
TUNNEL_PUBLIC_URL=

# --- better-auth ---
# 32文字以上のランダムな文字列を設定する。例: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# 開発時は vite dev のURL（vite.config.ts の server.port と揃える）。
# コンテナ起動時は docker-compose.yml が上書きする（nginxの公開ポートに合わせる）。
BETTER_AUTH_URL=http://localhost:5273

# --- pgAdmin (docker-compose の pgadmin サービス。DBをブラウザで見る用) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
# ホスト側の公開ポート
PGADMIN_PORT=5051

# --- メール送信 (docker-mailserver。問い合わせフォームの通知に使用) ---
# ホストから接続するときの接続先（pnpm dev 用）。
# アプリをコンテナで動かす場合は docker-compose.yml が mailserver:25 に上書きする。
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_SECURE=false
# 同じDockerネットワーク内からは認証なしでリレーできる設定にしているため空のままでよい
SMTP_USER=
SMTP_PASS=
MAIL_FROM="社内ダッシュボード <no-reply@example.com>"
# 問い合わせがあったときの通知先メールアドレス
CONTACT_NOTIFY_TO=admin@example.com
# docker-mailserver のドメイン名（社内限定のため実在ドメインでなくてよい）
MAIL_DOMAIN=shukudai2.local
# ホストから直接送信テストする場合の公開ポート
MAIL_SMTP_PORT=2525
